{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2024", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // vite/client: the texts of the app are loaded together with its env module.
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* The FSD layers: the texts of the app are imported from its config files. */
    "paths": {
      "@/app/*": ["../src/app/*"],
      "@/pages/*": ["../src/pages/*"],
      "@/features/*": ["../src/features/*"],
      "@/entities/*": ["../src/entities/*"],
      "@/shared/*": ["../src/shared/*"]
    }
  },
  "include": [".", "../playwright.config.ts"]
}
